# Surcharges personnelles : copier ce fichier vers .env (jamais committer de secrets prod).
# Les modes par défaut utilisent déjà :
#   DEV  → .env.development  (npm run dev)
#   TEST → .env.test         (npm run dev:test / build:test)

# Authentification (si vous surchargez .env)
# VITE_APP_USERNAME=admin
# VITE_APP_PASSWORD=

# Données (optionnel — défaut /data/agents.json)
# VITE_APP_DATA_URL=/data/agents.json

# Environnement affiché (development | test | staging | preview | production)
# VITE_APP_ENV=development

# Monitoring erreurs (optionnel — https://sentry.io)
# VITE_SENTRY_DSN=

# Neon / Netlify Functions (côté Netlify uniquement, pas VITE_)
# NETLIFY_DATABASE_URL=
