            "next-themes": "^0.4.6",
            "react": "^18.3.1",
            "react-day-picker": "^8.10.1",
            "react-dom": "^18.3.1",
            "react-hook-form": "^7.55.0",
            "react-resizable-panels": "^4.11.2",
            "react-simple-maps": "^3.0.0",
            "recharts": "^2.15.2",
